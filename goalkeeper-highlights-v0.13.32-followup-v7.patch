     genuine_interaction = (
         candidate.contact_frames >= 2 and 
-        (dynamics >= motion_floor or candidate.keeper_motion >= motion_floor or candidate.possession_duration >= 0.5)
+        (
+            dynamics >= motion_floor
+            or candidate.keeper_motion >= motion_floor
