+        )
     )
     
     central_min = float(validation.get("central_field_y_min", 0.36))
@@ -1068,7 +1073,16 @@ def rescue_classic_keeper_actions(items: list[Candidate], clips_cfg: dict[str, A
     for candidate in items:
